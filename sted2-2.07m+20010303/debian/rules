#!/usr/bin/make -f

STED_LIBDIR = /usr/lib/sted
STED_ETCDIR = /etc/sted2

# See "CFLAGS notes" in the top-level README: the 1990s codebase needs
# pre-GCC-10 semantics for inline, commons, and implicit declarations.
STED_CFLAGS = -g -O2 -fgnu89-inline -fcommon \
	-Wno-implicit-function-declaration -Wno-unused-result

%:
	dh $@

# The tree ships a working autoconf-2.13 configure; regenerating it with
# modern autotools fails, so skip autoreconf.
override_dh_autoreconf:

# The shipped configure is autoconf-2.13 era; call it directly instead of
# letting dh_auto_configure pass options it does not understand.
override_dh_auto_configure:
	# git checkouts have arbitrary timestamps; make the shipped autotools
	# output newer than its inputs so make never tries to regenerate it
	# with modern (incompatible) autoconf/automake.
	touch acinclude.m4 aclocal.m4 configure config.h.in stamp-h.in
	find . -name Makefile.in -exec touch {} +
	./configure --prefix=/usr \
		--mandir=/usr/share/man --infodir=/usr/share/info \
		--with-default-path=$(STED_LIBDIR)

override_dh_auto_build:
	dh_auto_build -- CFLAGS="$(STED_CFLAGS)"

override_dh_auto_install:
	dh_auto_install
	# Move user-editable config to /etc/sted2 and leave symlinks next to
	# the binary, where STed2's argv[0]-relative lookup expects them.
	install -d debian/sted2$(STED_ETCDIR)/deffile
	for f in sted2.cnf \
		deffile/cm64.def \
		deffile/sc55.def \
		deffile/sc55mk2.def \
		deffile/sc88.def ; do \
		mv debian/sted2$(STED_LIBDIR)/$$f debian/sted2$(STED_ETCDIR)/$$f ; \
		ln -sf $(STED_ETCDIR)/$$f debian/sted2$(STED_LIBDIR)/$$f ; \
	done

override_dh_auto_clean:
	[ ! -f Makefile ] || $(MAKE) distclean
	# A config.cache from another machine would poison this old configure.
	rm -f config.cache config.log etc/sted2.cnf etc/sted2.launcher
